# Server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Static key for the admin HTTP API (send as `x-api-key` header). At least 16 chars.
ADMIN_API_KEY=change-me-to-a-long-random-string
# Public HTTPS URL of the ngrok / Cloudflare tunnel pointing at this server (no trailing slash).
PUBLIC_BASE_URL=https://your-static-domain.ngrok-free.app
# Folder with product config files
PRODUCTS_DIR=./products

# LLM providers (only the ones referenced in product configs are required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram approval bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to approve/edit/reject drafts.
# Leave empty on first boot, send /chatid to the bot, then fill it in.
TELEGRAM_ALLOWED_USER_IDS=

# Meta app (Threads use case) - App Dashboard > App settings > Basic
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional fallback long-lived Threads token per product (used until an OAuth login replaces it).
# The variable name is set by `platform.tokenEnv` in the product config.
THREADS_TOKEN_YOLLLY=
